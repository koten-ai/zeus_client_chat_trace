{
  "name": "zeus_client_chat_trace",
  "version": "0.1.10",
  "private": true,
  "description": "Embeddable Zeus trace debugger widget",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "serve": "npx --yes serve . -p 5199",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publish:cdn": "scripts/upload_dist_cdn.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7"
  }
}
