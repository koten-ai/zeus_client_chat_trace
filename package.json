{
  "name": "zeus_client_chat_trace",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable Zeus trace debugger widget",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "serve": "npx --yes serve . -p 5199",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.5"
  }
}