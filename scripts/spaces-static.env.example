# Copy to spaces-static.env and fill in (gitignored).
# Or export these in the shell before npm run publish:cdn.

DO_SPACES_KEY=
DO_SPACES_SECRET=

# Optional overrides (defaults match production static CDN)
# DO_SPACES_STATIC_BUCKET=koten-static-cdn
# DO_SPACES_STATIC_REGION=nyc3
# DO_SPACES_STATIC_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_STATIC_PREFIX=zeus_client_chat_trace

# Optional: create/ensure CDN endpoint via DO API
# DIGITALOCEAN_TOKEN=
