# Copy to .env and fill in. .env is gitignored.
#
# Widget build (esbuild) reads only ZEUS_API_URL, ZEUS_AUTH_TOKEN, and
# HUB_BASE_URL. Runtime window.ZeusTraceConfig takes precedence.
# The other variables are for `npm run publish:cdn` and are not bundled.

ZEUS_API_URL=http://localhost:8080
ZEUS_AUTH_TOKEN=
# Hub / Detective origin. Leave empty for CDN builds so hosts must set
# ZeusTraceConfig.hubBaseUrl (or data-hub-base-url). Local playground can set:
# HUB_BASE_URL=http://127.0.0.1:9091
HUB_BASE_URL=

# DigitalOcean Spaces — required only for npm run publish:cdn
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_STATIC_BUCKET=
DO_SPACES_STATIC_REGION=
# DO_SPACES_STATIC_ENDPOINT=https://<region>.digitaloceanspaces.com
# DO_SPACES_STATIC_PREFIX=zeus_client_chat_trace
# DIGITALOCEAN_TOKEN=